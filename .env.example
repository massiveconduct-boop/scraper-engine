# ===== DATABASE =====
# PgBouncer DSN — connects to pgbouncer:6432 in docker-compose
PGBOUNCER_DSN=postgresql://scraper:scraper@localhost:6432/scraper_engine

# PostgreSQL DSN — direct connection for migrations
DATABASE_URL=postgresql+asyncpg://scraper:scraper@localhost:5432/scraper_engine

# ===== REDIS =====
REDIS_URL=redis://localhost:6379/0

# ===== S3 / MinIO (BD-07 retention: failed 30d, success 1d) =====
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=scraper-snapshots

# ===== CapSolver (BD-03: $1.00/day hard ceiling) =====
CAPSOLVER_API_KEY=

# NoCaptchaAI — primary CAPTCHA solver; CapSolver above is the fallback.
NOCAPTCHA_AI_API_KEY=

# ===== Firecrawl (optional — higher-quality markdown conversion) =====
# FetchResult.markdown is always populated regardless of these being set: a
# local converter (services/markdown_fallback.py) is used when neither is
# configured. Set these only if you want Firecrawl's conversion instead.
FIRECRAWL_API_KEY=
# Point at a self-hosted Firecrawl instance instead of the paid hosted API.
# Self-hosted instances commonly need no API key at all — base URL alone is enough.
FIRECRAWL_BASE_URL=

# ===== extraction-engine (optional, structured extraction) =====
# Unset means process_job simply falls back to AdaptiveSelector, no error.
EXTRACTION_ENGINE_BASE_URL=

# ===== App config =====
APP_ENV=staging
LOG_LEVEL=INFO

# ===== Tenant provisioning (BD-04: built into system) =====
# Default admin API key for tenant creation
ADMIN_API_KEY=sk-admin

# ===== Postgres / MinIO (docker-compose superuser + root creds) =====
# Matches docker-compose.yml's own ${VAR:-default} — same non-secret dev
# pattern already used by DATABASE_URL/PGBOUNCER_DSN above.
POSTGRES_PASSWORD=scraper
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ===== Monitoring (Prometheus + Alertmanager, docker-compose services) =====
# Slack incoming webhook — Alertmanager routes alerts here (two-tier: default
# + paging-channel, see monitoring/alertmanager/alertmanager.yml). Never
# commit a real value.
SLACK_WEBHOOK_URL=
